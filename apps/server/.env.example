DATABASE_URL=postgresql://crisscross:crisscross@localhost:5433/crisscross
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Authorized JavaScript origins: http://localhost:5173 (dev) and your production URL.
GOOGLE_CLIENT_ID=
# Comma-separated emails that become admins on login.
ADMIN_EMAILS=
# Enables POST /api/auth/dev (log in as any email without Google). Ignored when NODE_ENV=production.
DEV_LOGIN=true
PORT=3000
